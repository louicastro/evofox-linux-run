#!/usr/bin/env bash
# EvoFox Phantom Air launcher. Never escalates privileges or changes system files.
set -Eeuo pipefail
DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"

if (($#)); then
    if [[ -x "$DIR/evofox-ctl" ]]; then exec "$DIR/evofox-ctl" "$@"; fi
    if [[ -x "$DIR/tools/evofox-ctl" ]]; then exec "$DIR/tools/evofox-ctl" "$@"; fi
    if [[ -f "$DIR/evofox.py" ]]; then exec python3 "$DIR/evofox.py" "$@"; fi
    echo "evofox: no CLI found" >&2; exit 127
fi

if command -v python3 >/dev/null 2>&1 &&
   python3 -c "import gi; gi.require_version('Gtk','3.0'); from gi.repository import Gtk; raise SystemExit(0 if Gtk.init_check()[0] else 1)" >/dev/null 2>&1 &&
   [[ -f "$DIR/evofox-gtk.py" ]]; then
    exec python3 "$DIR/evofox-gtk.py"
fi
if [[ -f "$DIR/evofox-gui.py" ]]; then exec python3 "$DIR/evofox-gui.py"; fi
echo "evofox: no supported GUI found; install GTK 3/PyGObject or use the CLI." >&2
exit 1
