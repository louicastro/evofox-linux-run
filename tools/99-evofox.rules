# Amkette EvoFox Phantom Air (USB VID:PID 30fa:1440).
# Access is granted only to the active local desktop seat by logind.
# Do not use MODE=0666: it exposes the HID control node to every local user.
SUBSYSTEM=="hidraw", KERNEL=="hidraw*", ATTRS{idVendor}=="30fa", ATTRS{idProduct}=="1440", TAG+="uaccess"
